# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_DEV_CREDS=true

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
BCRYPT_SALT_ROUNDS=10

# ─── CIS Federation ──────────────────────────────────────────────────────────
# Canonical Identity Service base URL used for outbound sync/validation calls.
CIS_API_URL=https://cis.example.com
# Short platform slug that CIS uses to identify this app.
CIS_PLATFORM_SLUG=dmhicc
# Client credentials for outbound CIS API requests.
CIS_CLIENT_ID=dmhicc-client
CIS_CLIENT_SECRET=dmhicc-client-secret-7e6f27a9c95b4fd2b730d5b7a7614b5c
# Inbound webhook secret used to verify CIS sync events.
CIS_WEBHOOK_SECRET=dmhicc-webhook-secret-4b1c8d7902b043a9b75b73a0fbf96a31
# Canonical path that CIS should target when posting sync events.
CIS_WEBHOOK_PATH=/api/cis/webhook
# Allowed clock skew for webhook signatures (seconds).
CIS_WEBHOOK_ALLOWED_SKEW_SECONDS=300

# ─── Database (Phase 14 — Prisma + PostgreSQL) ──────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/dmhicc

# ─── Cache / Queue (Phase 14 — Redis) ───────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Media (Cloudinary) ─────────────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# --- Site URL (SEO / OG metadata) -------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://dmhicc.app
